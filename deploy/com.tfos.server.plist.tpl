<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tfos.server</string>
  <key>ProgramArguments</key><array><string>__ROOT__/deploy/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__DATA_DIR__/logs/server.log</string>
  <key>StandardErrorPath</key><string>__DATA_DIR__/logs/server.log</string>
</dict></plist>
