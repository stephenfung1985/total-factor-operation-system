# 复制为 ~/tfos-data/env 后修改（install.sh 会自动生成）。不要提交到 git。
TFOS_PRODUCTION=1
# 初始账号（fengxuecheng、jinliuchao、70152、gcjsb）首次建立时使用的密码，至少 8 位，含字母和数字。
# 各账号首次登录时仍会被强制修改。只在建库时生效，已存在的账号不受影响。
TFOS_INITIAL_PASSWORD=请改成你自己的初始密码1
TFOS_DB=__DATA_DIR__/tfos.db
TFOS_PORT=8000
# 上传文件大小上限（MB），默认 10
#TFOS_MAX_UPLOAD_MB=10
# 0.0.0.0 允许局域网访问；只用穿透、不要局域网直连时改成 127.0.0.1
TFOS_HOST=0.0.0.0
